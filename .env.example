# Copy to a local, uncommitted environment file. Never commit real values.
OPENLEARN_ENVIRONMENT=local
OPENLEARN_BUILD_VERSION=local
OPENLEARN_DASHBOARD_ORIGIN=http://localhost:4173
OPENLEARN_ALLOWED_ORIGINS=http://localhost:4173
OPENLEARN_SERVICE_HOST=0.0.0.0
OPENLEARN_SERVICE_PORT=3000
OPENLEARN_TRUST_PROXY=false
OPENLEARN_DATABASE_URL=postgres://openlearn:openlearn@localhost:5432/openlearn
OPENLEARN_DATABASE_POOL_MAX=10
OPENLEARN_OIDC_ISSUER=https://identity.example.test
OPENLEARN_OIDC_JWKS_URL=https://identity.example.test/.well-known/jwks.json
OPENLEARN_OIDC_AUDIENCE=https://service.example.test/mcp
OPENLEARN_DASHBOARD_AUDIENCE=https://dashboard.example.test
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
OPENLEARN_SESSION_SECRET=replace-with-at-least-32-random-bytes
OPENLEARN_METRICS_PATH=/metrics
OPENLEARN_METRICS_TOKEN=replace-with-a-private-32-character-token
OPENLEARN_RATE_LIMIT_MAX=120
OPENLEARN_RATE_LIMIT_WINDOW_MS=60000

# Local stdio smoke tests only; never use these values for hosted ownership.
OPENLEARN_LOCAL_OWNER_ID=local-owner
OPENLEARN_LOCAL_SCOPES=plan:read,plan:write,progress:write
